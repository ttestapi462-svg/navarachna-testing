{
  "expo": {
    "name": "Navarachna Designer Studio",
    "slug": "navarachna-designer-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Navarachna Designer Studio to access employee document images.",
          "savePhotosPermission": "Allow Navarachna Designer Studio to save employee document images to your gallery.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Navarachna Studio to take receipt photos.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "navarachna",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b1b9610-694f-4bf9-a16e-3e800acec8ce"
      }
    },
    "owner": "mobiletester2026s-team"
  }
}
